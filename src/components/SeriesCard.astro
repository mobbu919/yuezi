---
/**
 * SeriesCard — A series overview card with 3x3 mosaic thumbnail cover.
 *
 * Design: the top-level cover uses a 3x3 grid of the first 9 works in the
 * series, showing the visual character of the collection at a glance.
 * If the series has fewer than 9 works, the remaining cells show a count tile.
 *
 * Props:
 *   series  — Series object from src/data/series.js
 *   images  — Map of filename → processed image URL
 */

export interface Props {
  series: any;
  images: Map<string, string>;
}

const { series, images } = Astro.props;

// First 9 works for the mosaic cover
const coverWorks = series.works.slice(0, 9);
const remaining = series.works.length - coverWorks.length;
---

<a href={`/gallery/${series.slug}`} class="series-card" aria-label={`View series: ${series.name}`}>

  <!-- Mosaic cover -->
  <div class="series-cover">
    <div class="series-mosaic">
      {coverWorks.map((work, index) => {
        const src = images.get(work.file) || '';
        return (
          <div class="series-mosaic-cell" data-index={index}>
            <img
              src={src}
              alt={work.title}
              class="series-mosaic-img"
              loading="lazy"
              decoding="async"
            />
          </div>
        );
      })}

      <!-- Fill remaining cells with a count tile -->
      {Array.from({ length: Math.max(0, 9 - coverWorks.length) }).map((_, i) => (
        <div class="series-mosaic-cell series-mosaic-count" data-index={coverWorks.length + i}>
          <span class="series-count-label">
            {remaining > 0 ? `${remaining}+` : ''}
          </span>
        </div>
      ))}
    </div>

    <!-- Hover overlay -->
    <div class="series-overlay" aria-hidden="true">
      <span class="series-open-label">View Series</span>
    </div>
  </div>

  <!-- Card body -->
  <div class="series-body">
    <div class="series-heading">
      <span class="series-order">Series {series.order}</span>
      <span class="series-count">{series.works.length} Works</span>
    </div>
    <h3 class="series-name">{series.name}</h3>
    <p class="series-description">{series.description}</p>
  </div>

</a>

<style>
  .series-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* ---- Cover ---- */
  .series-cover {
    position: relative;
    overflow: hidden;
    margin-bottom: var(--spacing-md);
    background: var(--color-bg-alt);
  }

  .series-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    aspect-ratio: 1 / 1;
    gap: 2px;
    padding: 2px;
  }

  .series-mosaic-cell {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .series-mosaic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .series-card:hover .series-mosaic-img {
    transform: scale(1.06);
  }

  /* Count tile for series with < 9 works */
  .series-mosaic-count {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
  }

  .series-count-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* Hover overlay */
  .series-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-base);
    z-index: 1;
  }

  .series-open-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition-base), transform var(--transition-base);
    background: rgba(0, 0, 0, 0.55);
    padding: var(--spacing-xs) var(--spacing-lg);
  }

  .series-card:hover .series-overlay,
  .series-card:focus-visible .series-overlay {
    background: rgba(0, 0, 0, 0.08);
  }

  .series-card:hover .series-open-label,
  .series-card:focus-visible .series-open-label {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- Body ---- */
  .series-body {
    padding: 0;
  }

  .series-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .series-order,
  .series-count {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .series-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-tight);
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .series-description {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
  }
</style>
