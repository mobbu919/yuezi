---
/**
 * Gallery page — Series overview.
 * Displays all 5 series as cards with pre-rendered 3x3 mosaic covers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { seriesData } from '../data/series';
---

<BaseLayout
  title="Gallery"
  description="Yuezi's portfolio — 5 series, 67 works spanning painting, watercolour, and mixed media."
>
  <section class="section page-header">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          label={`Collections — ${seriesData.length} Series`}
          title="Gallery"
          description="Explore the collections — each series is a chapter of an ongoing visual conversation."
          align="left"
        />
      </div>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container">
      <div class="series-grid">
        {seriesData.map((series, index) => (
          <div class={`reveal reveal-delay-${(index % 3) + 1}`}>
            <SeriesCard series={series} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: 0;
  }

  .gallery-section {
    padding-top: var(--spacing-2xl);
  }

  .series-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl) var(--spacing-2xl);
  }

  @media (min-width: 640px) {
    .series-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .series-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
