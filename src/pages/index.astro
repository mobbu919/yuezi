---
/**
 * Home page — Hero + featured works from the collections.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { seriesData } from '../data/series';

// Import all images from all series
const imageGlob = import.meta.glob<{ default: string }>(
  '../assets/images/*/*.jpg',
  { eager: true, query: '?url' }
);

function findImage(slug: string, file: string): string {
  for (const [filepath, mod] of Object.entries(imageGlob)) {
    if (filepath.includes(`${slug}/${file}`)) {
      return mod.default;
    }
  }
  return '';
}

// Featured: last work of each series (5 pieces total)
const featured = seriesData
  .map((series) => ({
    series,
    work: series.works[series.works.length - 1],
  }))
  .reverse();

// Hero image: latest work from the first series
const heroTarget = featured[0];
const heroFile = heroTarget?.work.file || '';
const heroImageUrl = heroTarget ? findImage(heroTarget.series.slug, heroFile) : '';

// OG image for social sharing
const ogTarget = seriesData[seriesData.length - 1];
const ogImageUrl = ogTarget ? findImage(ogTarget.slug, ogTarget.works[ogTarget.works.length - 1].file) : '';
---

<BaseLayout
  title="Home"
  description="Yuezi Gallery — 悦子的作品集. Five series of paintings, watercolours, and mixed media."
  ogImage={ogImageUrl}
>
  <Hero
    title="Yuezi Gallery"
    subtitle="悦子的作品集 — A quiet conversation between colour, texture, and memory"
    ctaText="Explore"
    ctaHref="/gallery"
    imageUrl={heroImageUrl}
    imageAlt="Latest featured artwork"
  />

  <section class="section featured-section">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          label="Selected Works"
          title="Featured"
          description="One recent work from each collection."
        />
      </div>

      <div class="featured-grid">
        {featured.map((item, index) => {
          const img = findImage(item.series.slug, item.work.file);
          return (
            <div class={`reveal reveal-delay-${index + 1}`}>
              <GalleryCard
                imageUrl={img}
                imageAlt={item.work.title}
                title={item.work.title}
                category={item.series.name}
                description={`${item.work.material} · ${item.work.date}`}
                href={`/gallery/${item.series.slug}/${item.work.id}`}
                aspectRatio="4/3"
              />
            </div>
          );
        })}
      </div>

      <div class="featured-cta reveal">
        <a href="/gallery" class="btn">View All Collections</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-section {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-5xl);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xl);
  }

  .featured-cta {
    text-align: center;
    margin-top: var(--spacing-3xl);
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
