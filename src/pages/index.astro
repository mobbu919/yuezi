---
/**
 * Home page — Landing page with hero section and featured works.
 * Imports real artwork images via import.meta.glob.
 *
 * To update the hero or featured selection, simply change the
 * indices below and rebuild.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { galleryData } from '../data/gallery';

// Dynamically import all artwork images
const imageGlob = import.meta.glob<{ default: string }>(
  '../assets/images/art-*.jpg',
  { eager: true, query: '?url' }
);
const imageByFile = new Map<string, string>();
for (const [filepath, mod] of Object.entries(imageGlob)) {
  const filename = filepath.split('/').pop() || '';
  imageByFile.set(filename, mod.default);
}

// Featured works — the 3 most recent pieces
const featuredData = galleryData.slice(-3).reverse();
const heroFile = featuredData[0]?.file || 'art-01.jpg';
const heroImageUrl = imageByFile.get(heroFile) || '';
// OG image for social sharing: use the latest piece
const ogImageUrl = imageByFile.get(galleryData[galleryData.length - 1]?.file || 'art-01.jpg') || '';
---

<BaseLayout
  title="Home"
  description="Yuezi Gallery — A curated space for visual stories and quiet impressions."
  ogImage={ogImageUrl}
>
  <Hero
    title="Yuezi Gallery"
    subtitle="A curated space for visual stories and quiet impressions"
    ctaText="Explore"
    ctaHref="/gallery"
    imageUrl={heroImageUrl}
    imageAlt="Latest featured artwork"
  />

  <!-- Featured Works Section -->
  <section class="section featured-section">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          label="Selected Works"
          title="Recent"
          description="The latest additions to the collection — selected moments from the archive."
        />
      </div>

      <div class="featured-grid">
        {featuredData.map((item, index) => {
          const img = imageByFile.get(item.file) || '';
          const categories = ['Photography', 'Still Life', 'Landscape'];
          return (
            <div class={`reveal reveal-delay-${index + 1}`}>
              <GalleryCard
                imageUrl={img}
                imageAlt={`Featured work ${item.id}`}
                title={item.date}
                category={categories[index]}
                description={`Captured in ${item.date}.`}
                href="/gallery"
                aspectRatio="4/3"
              />
            </div>
          );
        })}
      </div>

      <div class="featured-cta reveal">
        <a href="/gallery" class="btn">View All {galleryData.length} Works</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-section {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-5xl);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xl);
  }

  .featured-cta {
    text-align: center;
    margin-top: var(--spacing-3xl);
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
