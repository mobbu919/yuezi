---
/**
 * Artwork detail page — shows one work inside a series.
 * URL: /gallery/{series-slug}/{work-id}
 *
 * Displays the large image plus title, material, date, and
 * prev/next navigation within the same series.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { seriesData } from '../../../data/series';

// Generate one page per (series, work) pair
export function getStaticPaths() {
  return seriesData.flatMap((series) =>
    series.works.map((work) => ({
      params: { series: series.slug, id: String(work.id) },
      props: { series, work },
    }))
  );
}

export interface Props {
  series: typeof seriesData[number];
  work: typeof seriesData[number]['works'][number];
}

const { series, work } = Astro.props;

// Import the artwork image
const imageGlob = import.meta.glob<{ default: string }>(
  '../../../assets/images/*/*.jpg',
  { eager: true, query: '?url' }
);
const imageUrl =
  Object.entries(imageGlob).find(([path]) =>
    path.includes(`${series.slug}/${work.file}`)
  )?.[1]?.default || '';

// Previous / Next within the series
const workIndex = series.works.findIndex((w) => w.id === work.id);
const prevWork = workIndex > 0 ? series.works[workIndex - 1] : null;
const nextWork = workIndex < series.works.length - 1 ? series.works[workIndex + 1] : null;
---

<BaseLayout
  title={work.title}
  description={`${work.title} — ${work.material}, ${work.date} · ${series.name}`}
  ogImage={imageUrl}
>
  <article class="detail-section section">
    <div class="container-narrow">

      <!-- Breadcrumb -->
      <nav class="detail-breadcrumb reveal" aria-label="Breadcrumb">
        <a href="/gallery" class="detail-back">Gallery</a>
        <span class="detail-sep" aria-hidden="true">/</span>
        <a href={`/gallery/${series.slug}`} class="detail-back">{series.name}</a>
        <span class="detail-sep" aria-hidden="true">/</span>
        <span class="detail-current">{work.title}</span>
      </nav>

      <!-- Main Image -->
      <div class="detail-image-wrapper reveal">
        <img
          src={imageUrl}
          alt={work.title}
          class="detail-image"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Metadata -->
      <div class="detail-meta reveal reveal-delay-1">
        <div class="detail-meta-row">
          <span class="detail-label">Title</span>
          <span class="detail-value">{work.title}</span>
        </div>
        <div class="detail-meta-row">
          <span class="detail-label">Material</span>
          <span class="detail-value">{work.material}</span>
        </div>
        <div class="detail-meta-row">
          <span class="detail-label">Series</span>
          <span class="detail-value">
            <a href={`/gallery/${series.slug}`} class="detail-series-link">{series.name}</a>
          </span>
        </div>
        <div class="detail-meta-row">
          <span class="detail-label">Date</span>
          <span class="detail-value">{work.date}</span>
        </div>
      </div>

      <!-- Navigation within series -->
      <nav class="detail-nav reveal reveal-delay-2" aria-label="Artwork navigation">
        {prevWork ? (
          <a href={`/gallery/${series.slug}/${prevWork.id}`} class="detail-nav-link detail-nav-prev">
            <span class="detail-nav-arrow" aria-hidden="true">&larr;</span>
            <span class="detail-nav-text">
              <span class="detail-nav-label">Previous</span>
              <span class="detail-nav-title">{prevWork.title}</span>
            </span>
          </a>
        ) : <div></div>}
        {nextWork ? (
          <a href={`/gallery/${series.slug}/${nextWork.id}`} class="detail-nav-link detail-nav-next">
            <span class="detail-nav-text">
              <span class="detail-nav-label">Next</span>
              <span class="detail-nav-title">{nextWork.title}</span>
            </span>
            <span class="detail-nav-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ) : <div></div>}
      </nav>

    </div>
  </article>
</BaseLayout>

<style>
  .detail-section {
    padding-top: var(--spacing-2xl);
    padding-bottom: var(--spacing-5xl);
  }

  .detail-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-2xl);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .detail-back {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--color-border);
  }

  .detail-back:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-text);
  }

  .detail-sep { color: var(--color-border); }
  .detail-current { color: var(--color-text-muted); }

  .detail-image-wrapper {
    margin-bottom: var(--spacing-2xl);
    background: var(--color-bg-alt);
  }

  .detail-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .detail-meta {
    margin-bottom: var(--spacing-3xl);
  }

  .detail-meta-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .detail-meta-row:last-child {
    border-bottom: none;
  }

  .detail-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    min-width: 72px;
    flex-shrink: 0;
  }

  .detail-value {
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .detail-series-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--color-border);
    transition: color var(--transition-fast);
  }

  .detail-series-link:hover {
    color: var(--color-text-secondary);
  }

  .detail-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-lg);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-border-light);
  }

  .detail-nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    max-width: 45%;
  }

  .detail-nav-link:hover { color: var(--color-text); }
  .detail-nav-next { text-align: right; justify-content: flex-end; }

  .detail-nav-arrow {
    font-size: var(--font-size-xl);
    line-height: 1;
    flex-shrink: 0;
  }

  .detail-nav-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .detail-nav-label {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .detail-nav-title {
    font-size: var(--font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }

  @media (max-width: 640px) {
    .detail-nav-title { display: none; }
  }
</style>
