---
/**
 * Artwork detail page — static-generated for each gallery piece.
 * URL: /gallery/1, /gallery/2, ... /gallery/67
 *
 * To customize, edit the entry in src/data/gallery.js.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleryData } from '../../data/gallery';

// SSG: generate one page per artwork
export function getStaticPaths() {
  return galleryData.map((work) => ({
    params: { id: String(work.id) },
    props: { work },
  }));
}

export interface Props {
  work: typeof galleryData[number];
}

const { work } = Astro.props;

// Import the artwork image
const imageGlob = import.meta.glob<{ default: string }>(
  '../../assets/images/art-*.jpg',
  { eager: true, query: '?url' }
);
const imageUrl = imageGlob[`../../assets/images/${work.file}`]?.default || '';

// Previous / Next navigation
const prevWork = work.id > 1 ? galleryData.find((w) => w.id === work.id - 1) : null;
const nextWork = work.id < galleryData.length ? galleryData.find((w) => w.id === work.id + 1) : null;
---

<BaseLayout
  title={work.title}
  description={`${work.title} — ${work.category}, ${work.date}`}
  ogImage={imageUrl}
>
  <article class="detail-section section">
    <div class="container-narrow">

      <!-- Breadcrumb -->
      <nav class="detail-breadcrumb reveal" aria-label="Breadcrumb">
        <a href="/gallery" class="detail-back">Gallery</a>
        <span class="detail-sep" aria-hidden="true">/</span>
        <span class="detail-current">{work.title}</span>
      </nav>

      <!-- Main Image -->
      <div class="detail-image-wrapper reveal">
        <img
          src={imageUrl}
          alt={work.title}
          class="detail-image"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Metadata -->
      <div class="detail-meta reveal reveal-delay-1">
        <div class="detail-meta-row">
          <span class="detail-label">Title</span>
          <span class="detail-value">{work.title}</span>
        </div>
        <div class="detail-meta-row">
          <span class="detail-label">Category</span>
          <span class="detail-value">{work.category}</span>
        </div>
        <div class="detail-meta-row">
          <span class="detail-label">Date</span>
          <span class="detail-value">{work.date}</span>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="detail-nav reveal reveal-delay-2" aria-label="Artwork navigation">
        {prevWork ? (
          <a href={`/gallery/${prevWork.id}`} class="detail-nav-link detail-nav-prev">
            <span class="detail-nav-arrow" aria-hidden="true">&larr;</span>
            <span class="detail-nav-text">
              <span class="detail-nav-label">Previous</span>
              <span class="detail-nav-title">{prevWork.title}</span>
            </span>
          </a>
        ) : <div></div>}
        {nextWork ? (
          <a href={`/gallery/${nextWork.id}`} class="detail-nav-link detail-nav-next">
            <span class="detail-nav-text">
              <span class="detail-nav-label">Next</span>
              <span class="detail-nav-title">{nextWork.title}</span>
            </span>
            <span class="detail-nav-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ) : <div></div>}
      </nav>

    </div>
  </article>
</BaseLayout>

<style>
  .detail-section {
    padding-top: var(--spacing-2xl);
    padding-bottom: var(--spacing-5xl);
  }

  .detail-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-2xl);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .detail-back {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--color-border);
  }

  .detail-back:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-text);
  }

  .detail-sep { color: var(--color-border); }
  .detail-current { color: var(--color-text-muted); }

  .detail-image-wrapper {
    margin-bottom: var(--spacing-2xl);
    background: var(--color-bg-alt);
  }

  .detail-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .detail-meta {
    margin-bottom: var(--spacing-3xl);
  }

  .detail-meta-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .detail-meta-row:last-child {
    border-bottom: none;
  }

  .detail-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    min-width: 72px;
    flex-shrink: 0;
  }

  .detail-value {
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .detail-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-lg);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-border-light);
  }

  .detail-nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    max-width: 45%;
  }

  .detail-nav-link:hover { color: var(--color-text); }
  .detail-nav-next { text-align: right; justify-content: flex-end; }

  .detail-nav-arrow {
    font-size: var(--font-size-xl);
    line-height: 1;
    flex-shrink: 0;
  }

  .detail-nav-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .detail-nav-label {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .detail-nav-title { font-size: var(--font-size-sm); }

  @media (max-width: 640px) {
    .detail-nav-title { display: none; }
  }
</style>
